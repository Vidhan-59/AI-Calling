# =====================================================================
#  ShiftEaze AI Calling (OmniVoice edition) - what must NEVER be committed
# =====================================================================

# --- Secrets / local configuration ------------------------------------
# .env holds Twilio, Sarvam and other keys. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Runtime data (databases, call recordings/transcripts, voices) -----
# Contains real phone numbers and call transcripts, and the voice library
# holds people's voice samples - never publish any of it.
data/
*.db
*.sqlite
*.sqlite3
voice_assignments.json
tts_cache/

# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
build/
dist/
.eggs/
pip-wheel-metadata/

# --- Virtual environments / installs for the TTS service ----------------
tts_service/.venv/
tts_service/install.*

# --- Models and large binaries (downloaded on first run, not source) ----
*.onnx
*.onnx.json
*.safetensors
*.pt
*.pth
*.bin
*.gguf
*.ct2
local_ai/voices/
omnivoice-model/
stt_models/
whisper-*/
*.whl

# --- Audio produced while running or testing -----------------------------
*.wav
*.pcm
*.mp3
*.ogg
*.flac
# (the tracked STT benchmark clips live outside the repo: data/stt_testset)

# --- Logs and run artifacts -------------------------------------------
*.log
*.log.*
*.err
server.log
server.log.err
tunnel.log
tunnel.log.err
tts_service.log
tts_service.log.err
run-all-output.log
*.tmp
*.temp
*.tmp.txt
tools/simulate_last_run.log

# --- Tests / tooling caches --------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Editors / OS / assistants -------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
.claude/
