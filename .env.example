# ============================================================
# Anthropic (Claude)
# ============================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CONVERSATION_MODEL=claude-haiku-4-5
SUPERVISOR_MODEL=claude-sonnet-5
SENTIMENT_MODEL=claude-haiku-4-5
DEFAULT_CLAUDE_MODEL=claude-opus-5

# ============================================================
# Database
# ------------------------------------------------------------
# Zero-setup local dev: leave DATABASE_URL unset and the app uses
# an aiosqlite file under ./data/app.db. For anything beyond a
# laptop demo, point this at Postgres - it is the only line that
# has to change:
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ai_calling
# ============================================================
DATABASE_URL=

# ============================================================
# Redis (session state, Streams queues, rate limits, kill-switch)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Telephony - provider-abstracted, see services/telephony/
# Set TELEPHONY_PROVIDER to: mock | twilio | exotel | plivo
# "mock" needs no credentials and is the default for local dev.
# ============================================================
TELEPHONY_PROVIDER=mock

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_VIRTUAL_NUMBER=

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# ============================================================
# STT - see USE_SARVAM_STT below
# ============================================================
SARVAM_API_KEY=

# ============================================================
# TTS - OmniVoice (k2-fsa/OmniVoice), a separate service: tts_service/
# ------------------------------------------------------------
# Runs in its own venv/process (torch + omnivoice) and owns the GPU model and
# the voice library. Start it with .\tts_service\run-tts.ps1 (see
# tts_service/README.md). Create, clone and assign voices at
# http://localhost:8000/voice-studio
# ============================================================
TTS_SERVICE_URL=http://127.0.0.1:8100
# Must match TTS_SERVICE_TOKEN in the TTS service's environment. Set it
# whenever the service is reachable by anything but this app.
TTS_SERVICE_TOKEN=
TTS_REQUEST_TIMEOUT_SECONDS=20
# Diffusion steps per utterance: live agent replies vs pre-rendered scripted lines.
# TTS_LIVE_NUM_STEP=16
# Short first piece of a live reply: fewer steps = faster first audio.
# TTS_SHORT_PIECE_NUM_STEP=10
# Agent calls: play a cached "जी।" if the reply hasn't started this many ms after
# the caller finished (0 = off).
LATE_FILLER_MS=700
# TTS_CACHED_NUM_STEP=32

# ============================================================
# Voice pipeline for scenario calls (services/voice_pipeline/)
# ------------------------------------------------------------
# SCENARIO_VOICE_TRANSPORT: "media" (default) = Twilio Media Streams + STT
# (below) + OmniVoice TTS. "relay" = the older Twilio ConversationRelay path
# with Google STT/TTS - one-line rollback. ("sarvam" is still accepted as an
# alias of "media" for old .env files.)
# The scripts use feminine first-person Hindi/Gujarati verb forms ("bol
# rahi hoon"), so assign a FEMALE voice in Voice Studio.
# Test without a phone: .\venv\Scripts\python.exe tools\simulate_scenario_call.py
# ============================================================
SCENARIO_VOICE_TRANSPORT=media
SARVAM_STT_MODEL=saaras:v3

# STT switch. true  = Sarvam saaras:v3 cloud STT (most accurate, needs
#                     SARVAM_API_KEY, paid per minute).
#             false = open-source Whisper on this machine's GPU
#                     (services/voice_pipeline/local_stt.py).
USE_SARVAM_STT=true

# --- Local Whisper (only used when USE_SARVAM_STT=false) ---
# Model choice comes from tools/stt_benchmark.py - re-run it on the
# deployment server. Convert the Indic fine-tunes once with
#   python tools/convert_stt_models.py
# Laptop (8GB GPU, shared with Qwen + OmniVoice): Hindi + Gujarati "medium"
# fine-tunes. Server (>=16GB GPU): set LOCAL_STT_MODEL_HI to the converted
# whisper-hindi-large-v2 for ~2 points better Hindi intent accuracy.
# LOCAL_STT_MODEL_HI=C:/Users/<you>/.cache/ai-calling/stt_models/whisper-hindi-medium
# LOCAL_STT_MODEL_GU=C:/Users/<you>/.cache/ai-calling/stt_models/whisper-gujarati-medium
LOCAL_STT_MODEL=Systran/faster-whisper-medium
LOCAL_STT_PRELOAD=hi,gu
# float16, not int8_float16: int8 kernels fail on RTX 50xx (Blackwell).
LOCAL_STT_COMPUTE_TYPE=float16
LOCAL_STT_BEAM_SIZE=1
# "process" = decode in a dedicated worker process (default; in-process the
# server's event loop starved Whisper of the GIL and decodes ran ~2x slower).
LOCAL_STT_ISOLATION=process
# GPU memory budget. An 8GB card cannot hold Qwen + OmniVoice + two Whisper
# models at once (the overflow stalls decodes). Only this many Whisper models
# stay on the GPU (the call's language); the rest wait in CPU RAM and swap in
# in ~0.3s. Idle models are parked after N seconds (0 = never). On a >=16GB
# GPU use LOCAL_STT_GPU_MODELS=2.
LOCAL_STT_GPU_MODELS=1
LOCAL_STT_IDLE_OFFLOAD_SECS=30
# If a local decode fails/times out, retry that utterance on Sarvam (needs
# SARVAM_API_KEY; costs only on failures). false = strictly no cloud spend.
LOCAL_STT_FALLBACK_SARVAM=true

# --- Low-latency voice architecture (see VOICE_LATENCY.md) ---
# Layer 2: RNNoise -> Silero VAD (speech held VAD_START_SECS) -> barge-in.
NOISE_SUPPRESSION=true
VAD_START_SECS=0.15
VAD_CONFIDENCE=0.7
VAD_MIN_VOLUME=0.6
# Decode the caller's words during the end-of-turn pause, not after it
# (local Whisper only; Sarvam STT streams on its own).
SPECULATIVE_STT=true
SPECULATE_AFTER_SECS=0.12
# Layer 1: agent replies spoken while the LLM is still writing them. Each
# piece is one OmniVoice request; the first goes out after this many words.
STREAM_LLM_REPLIES=true
STREAM_FIRST_CHUNK_WORDS=3

# ============================================================
# Odoo / ShiftEaze integration
# ============================================================
ODOO_WEBHOOK_URL=
ODOO_WEBHOOK_HMAC_SECRET=change_me_in_production

# ============================================================
# SMS fallback
# ============================================================
SMS_PROVIDER=mock

# ============================================================
# Server
# ============================================================
NGROK_URL=https://your-ngrok-url.ngrok-free.app
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================
# Safety
# ============================================================
GLOBAL_KILL_SWITCH_REDIS_KEY=ai_calling:kill_switch
MAX_CONCURRENT_CALLS=50

# ============================================================
# Dialer (services/dispatch/dialer.py)
# ------------------------------------------------------------
# DIALER_ENABLED defaults to false on purpose: starting a background loop
# that dials real numbers just because the server booted is exactly how a
# number gets blacklisted by someone who never asked to be called. Leave
# this false until you have real consented contacts and have tested
# POST /dialer/run-once manually at least once.
# ============================================================
DIALER_ENABLED=false
DIALER_POLL_INTERVAL_SECONDS=15

# ============================================================
# nltk (pulled in transitively via pipecat's RTVI processor)
# ------------------------------------------------------------
# nltk 3.10.1 ships a CWD-hijacking guard (nltk/inisec.py, CWE-427) that
# false-positives on any project whose venv lives inside the repo (this
# project's layout) - it can't tell a normal pip-installed package under
# venv/Lib/site-packages from a malicious same-named file at the repo root,
# since both resolve as "under cwd". Required for any process that imports
# pipecat.pipeline.task (e.g. the voice pipeline) when run with the repo
# root as the working directory - without this, that import raises
# ImportError. Safe here specifically because this repo's `regex` package
# (nltk's dependency that trips the guard) is a normal pip install, not a
# planted file - this is not a blanket security opt-out.
# ============================================================
NLTK_DISABLE_IMPORT_SECURITY=1

# ============================================================
# Admin auth (services/auth.py)
# ------------------------------------------------------------
# Guards routers/campaigns.py (contacts/campaigns/kill-switch/dialer admin)
# and routers/analytics.py (call transcripts/outcomes) - callers must send
# this value in an X-API-Key header. Left unset, those endpoints run with
# NO authentication (a loud warning is logged on first request) - set this
# before exposing the server outside a trusted network.
# ============================================================
ADMIN_API_KEY=

# ============================================================
# Local AI pipeline (local_ai/) - self-hosted STT+LLM+TTS
# Requires Ollama running locally (https://ollama.com) with the model
# pulled: `ollama pull qwen2.5:7b-instruct`. See LOCAL_AI_README.md.
# ============================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen2.5:7b-instruct (Apache-2.0) beat phi4-mini (MIT) on classification
# accuracy in testing (3/3 vs 1/3 correct on Hindi negation/escalation cases).
# On a GPU (100%-offloaded via Ollama), re-benchmarked through the real
# conversation-agent code path at 0.9-1.7s/turn - fast enough for live calls.
# Also benchmarked qwen3:8b as an upgrade candidate: 2-4x slower (likely its
# default "thinking mode") and returned empty replies on non-tool turns in
# this app's Ollama tool-calling contract - a real defect, not adopted.
# See LOCAL_AI_README.md for the full comparison.
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_WHISPER_MODEL=small
LOCAL_PIPER_VOICE_EN=en_US-lessac-medium
LOCAL_PIPER_VOICE_HI=hi_IN-pratham-medium
LOCAL_PIPER_VOICE_GU=

# "claude" or "local" (routes Track B's scenario classification through
# Ollama). Default is "local": on a GPU, Ollama is fast enough for live calls
# (~1s/turn, see above) - this removes the Claude/Anthropic dependency
# entirely. Set back to "claude" only as a rollback if the local backend
# misbehaves, or on CPU-only hardware without a GPU (23-60s/turn there -
# unusable for a live call, safe only for offline/batch/dev/QA use).
SCENARIO_LLM_BACKEND=local

# LLM_BACKEND is the broader switch: "local" routes EVERY LLM call in the
# app through Ollama - Track A's free-form replies/sentiment, Track B
# (falls back to SCENARIO_LLM_BACKEND above if this is unset), and the
# rebuild's flow-graph conversation agent (tool-calling included - verified
# against qwen2.5:7b-instruct's tool_calls support in Ollama's /api/chat).
# No ANTHROPIC_API_KEY is needed anywhere when this is "local".
LLM_BACKEND=local

# --- Agent Studio "Call now" ---
# The phone number the Call now section of an agent dials (international format,
# e.g. +919876543210, or a 10-digit Indian mobile number). Re-read on every call: change it without restarting the server.
# Needs TWILIO_* and NGROK_URL. On a Twilio trial account the number must be a verified caller ID.
STUDIO_CALL_NUMBER=
# STUDIO_REPLY_MAX_TOKENS=220
# STUDIO_MAX_CALL_SECS=600
