# ============================================================
# Anthropic (Claude)
# ============================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CONVERSATION_MODEL=claude-haiku-4-5
SUPERVISOR_MODEL=claude-sonnet-5
SENTIMENT_MODEL=claude-haiku-4-5
DEFAULT_CLAUDE_MODEL=claude-opus-5

# ============================================================
# Database
# ------------------------------------------------------------
# Zero-setup local dev: leave DATABASE_URL unset and the app uses
# an aiosqlite file under ./data/app.db. For anything beyond a
# laptop demo, point this at Postgres - it is the only line that
# has to change:
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ai_calling
# ============================================================
DATABASE_URL=

# ============================================================
# Redis (session state, Streams queues, rate limits, kill-switch)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Telephony - provider-abstracted, see services/telephony/
# Set TELEPHONY_PROVIDER to: mock | twilio | exotel | plivo
# "mock" needs no credentials and is the default for local dev.
# ============================================================
TELEPHONY_PROVIDER=mock

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_VIRTUAL_NUMBER=

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# ============================================================
# STT - provider-abstracted, see services/stt/
# Set STT_PROVIDER to: mock | sarvam | deepgram
# ============================================================
STT_PROVIDER=mock
SARVAM_API_KEY=
DEEPGRAM_API_KEY=

# ============================================================
# TTS - provider-abstracted, see services/tts/
# Set TTS_PROVIDER to: mock | sarvam | elevenlabs | azure
# ============================================================
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ============================================================
# Odoo / ShiftEaze integration
# ============================================================
ODOO_WEBHOOK_URL=
ODOO_WEBHOOK_HMAC_SECRET=change_me_in_production

# ============================================================
# SMS fallback
# ============================================================
SMS_PROVIDER=mock

# ============================================================
# Server
# ============================================================
NGROK_URL=https://your-ngrok-url.ngrok-free.app
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================
# Safety
# ============================================================
GLOBAL_KILL_SWITCH_REDIS_KEY=ai_calling:kill_switch
MAX_CONCURRENT_CALLS=50

# ============================================================
# Local AI pipeline (local_ai/) - fully offline STT+LLM+TTS
# Requires Ollama running locally (https://ollama.com) with the model
# pulled: `ollama pull qwen2.5:7b-instruct`. See LOCAL_AI_README.md.
# ============================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen2.5:7b-instruct (Apache-2.0) beat phi4-mini (MIT) on classification
# accuracy in testing (3/3 vs 1/3 correct on Hindi negation/escalation cases)
# at the cost of being slower - worth it for offline/QA use. See
# LOCAL_AI_README.md for the full comparison.
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_WHISPER_MODEL=small
LOCAL_PIPER_VOICE_EN=en_US-lessac-medium
LOCAL_PIPER_VOICE_HI=hi_IN-pratham-medium
LOCAL_PIPER_VOICE_GU=

# "claude" (default, unchanged live-call behavior) or "local" (routes
# scenario classification through Ollama). Measured 23-60s/turn on a CPU-only
# machine with no GPU, for either model - a hardware ceiling, not a model
# choice. Do not use "local" for live calls without a GPU. Safe for
# offline/batch/dev/QA use. See LOCAL_AI_README.md.
SCENARIO_LLM_BACKEND=claude
