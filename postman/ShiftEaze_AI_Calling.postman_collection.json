    {
      "name": "4. Place a real call",
      "description": "Needs `ANTHROPIC_API_KEY`, `TWILIO_*` and a real public `NGROK_URL` in `.env`, with the server restarted after editing `.env`. Read §7 of POSTMAN_GUIDE.md first — the telephony leg is not yet verified on this account.",
      "item": [
        {
          "name": "01 Call — Shift Confirm (Hindi)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.call_sid) {",
                  "  pm.collectionVariables.set('call_sid', b.call_sid);",
                  "  console.log('saved call_sid =', b.call_sid);",
                  "  console.log('operator will hear:', b.will_say);",
                  "} else {",
                  "  console.log('call not placed:', JSON.stringify(b));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"scenario_id\": \"shift_confirm\",\n  \"language\": \"hi\",\n  \"attempt\": 1,\n  \"to_phone_number\": \"{{to_phone_number}}\",\n  \"rgid\": \"RG12345\",\n  \"facts\": {\n    \"employee_name\": \"{{employee_name}}\",\n    \"date\": \"2 अगस्त\",\n    \"time\": \"सुबह 8\",\n    \"shift_name\": \"Day\",\n    \"terminal\": \"{{terminal}}\",\n    \"supervisor_name\": \"{{supervisor_name}}\"\n  }\n}"
