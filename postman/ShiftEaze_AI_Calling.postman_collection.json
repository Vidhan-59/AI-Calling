    {
      "name": "5. Outcomes",
      "item": [
        {
          "name": "List all scenario calls",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/scenario-calls",
              "host": ["{{base_url}}"],
              "path": ["scenario-calls"]
            },
            "description": "Newest first. Each row carries the scenario, language, facts dialled with, matched branch and outcome."
          }
        },
        {
          "name": "List calls filtered by scenario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/scenario-calls?scenario_id=shift_confirm&limit=50",
              "host": ["{{base_url}}"],
              "path": ["scenario-calls"],
              "query": [
                { "key": "scenario_id", "value": "shift_confirm" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Get one scenario call (uses saved call_sid)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/scenario-calls/{{call_sid}}",
              "host": ["{{base_url}}"],
              "path": ["scenario-calls", "{{call_sid}}"]
            },
            "description": "`{{call_sid}}` is filled automatically by any request in **4. Place a real call**.\n\nReturns the facts used, `matched_branch`, `outcome`, anything `collected` (e.g. the absence reason), the `detected_language` the operator actually spoke, plus the verbatim transcript with per-turn sentiment and an `escalation_recommended` flag."
          }
        }
      ]
    },
    {
      "name": "6. Generic agent (non-ShiftEaze)",
      "description": "The free-form agent that predates the ShiftEaze scenarios — any prompt, any use case. Unrelated to the five scripted scenarios; included so the whole API is in one collection.",
      "item": [
        {
          "name": "List agents",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/agents", "host": ["{{base_url}}"], "path": ["agents"] }
          }
        },
        {
          "name": "Create an agent",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"Sales Bot\",\n  \"system_prompt\": \"You are a friendly sales rep for Acme Corp. Keep replies short and warm.\",\n  \"welcome_greeting\": \"Hi! Thanks for calling Acme, how can I help?\",\n  \"knowledge_base\": [\n    \"Acme ships in 3-5 business days\",\n    \"Returns are accepted within 30 days of purchase\"\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/agents", "host": ["{{base_url}}"], "path": ["agents"] },
            "description": "Returns an auto-generated `id` (e.g. `sales-bot`) to use as `agent_id` elsewhere."
          }
        },
        {
          "name": "Update an agent's prompt (live)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"system_prompt\": \"You are now also allowed to discuss bulk order discounts.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/agents/sales-bot",
              "host": ["{{base_url}}"],
              "path": ["agents", "sales-bot"]
            },
            "description": "Takes effect on the very next call or message — no redeploy, no fine-tuning."
          }
        },
        {
          "name": "Chat with an agent (no phone)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"agent_id\": \"default\",\n  \"session_id\": \"chat-1\",\n  \"message\": \"Hi, I am really frustrated because my delivery is 3 days late!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/chat/test",
              "host": ["{{base_url}}"],
              "path": ["chat", "test"]
            },
            "description": "Returns the reply plus a `sentiment` block (label, score, emotion, escalate flag). Try a frustrated message and watch the reply get more empathetic."
          }
        },
        {
          "name": "Delete an agent",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/agents/sales-bot",
              "host": ["{{base_url}}"],
              "path": ["agents", "sales-bot"]
            },
            "description": "The built-in `default` agent cannot be deleted."
          }
        }
      ]
