              "raw": "{\n  \"scenario_id\": \"ot_request\",\n  \"language\": \"gu\",\n  \"facts\": {\n    \"employee_name\": \"Kiran\",\n    \"terminal\": \"{{terminal}}\",\n    \"shortfall_count\": \"3\",\n    \"duration\": \"8 કલાક\",\n    \"supervisor_name\": \"{{supervisor_name}}\"\n  },\n  \"utterances\": [\n    \"હા ભાઈ આવી જઈશ\",\n    \"ના યાર આજે નહીં આવી શકું\",\n    \"કેટલા પૈસા મળશે એ કહો પહેલા\",\n    \"કેટલા કલાક કામ કરવાનું છે?\",\n    \"મેં ગઈકાલે પણ ઓટી કરી હતી ભાઈ\",\n    \"મારે સુપરવાઇઝર સાથે વાત કરવી છે\"\n  ]\n}"
